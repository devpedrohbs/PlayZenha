generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PlanCode {
  free
  premium
  ultimate
}

enum BillingInterval {
  month
  year
}

enum Currency {
  BRL
}

enum Entitlement {
  play_free_games
  play_premium_games
  play_adult_games
  remove_ads
  use_ai
  advanced_statistics
  early_access
}

enum GameDifficulty {
  easy
  medium
  hard
}

enum GameStatus {
  available
  comingSoon @map("coming-soon")
  disabled
}

model Game {
  id                     String         @id @default(uuid()) @db.Uuid
  slug                   String         @unique
  name                   String
  shortDescription       String
  category               String
  minPlayers             Int
  maxPlayers             Int
  averageDurationMinutes Int
  difficulty             GameDifficulty
  status                 GameStatus
  requiredPlan           PlanCode
  tags                   String[]
  featured               Boolean        @default(false)
  isNew                  Boolean        @default(false)
  icon                   String?
  colors                 String[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([status])
  @@index([requiredPlan])
}

model SubscriptionPlan {
  code            PlanCode        @id
  name            String
  priceCents      Int
  currency        Currency        @default(BRL)
  billingInterval BillingInterval
  entitlements    Entitlement[]
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}
