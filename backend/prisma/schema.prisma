generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PlanCode {
  free
  premium
  ultimate
}

enum BillingInterval {
  month
  year
}

enum Currency {
  BRL
}

enum Entitlement {
  play_free_games
  play_premium_games
  play_adult_games
  remove_ads
  use_ai
  advanced_statistics
  early_access
}

enum GameDifficulty {
  easy
  medium
  hard
}

enum GameStatus {
  available
  comingSoon @map("coming-soon")
  disabled
}

enum UserRole {
  player
  admin
}

enum AccountStatus {
  active
  suspended
  disabled
}

enum SubscriptionStatus {
  active
  trialing
  pastDue
  canceled
  expired
}

enum AccessGrantType {
  allGames
}

enum PrivilegedAuditAction {
  accessGrantCreated
  accessGrantRevoked
}

enum IdentityProvider {
  google
}

model Game {
  id                     String         @id @default(uuid()) @db.Uuid
  slug                   String         @unique
  name                   String
  shortDescription       String
  category               String
  minPlayers             Int
  maxPlayers             Int
  averageDurationMinutes Int
  difficulty             GameDifficulty
  status                 GameStatus
  requiredPlan           PlanCode
  tags                   String[]
  featured               Boolean        @default(false)
  isNew                  Boolean        @default(false)
  icon                   String?
  colors                 String[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  publishedAt            DateTime?
  content                GameContent?

  @@index([status])
  @@index([requiredPlan])
}

model SubscriptionPlan {
  code            PlanCode           @id
  name            String
  priceCents      Int
  currency        Currency           @default(BRL)
  billingInterval BillingInterval
  entitlements    Entitlement[]
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  subscriptions   UserSubscription[]
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  nickname            String
  email               String               @unique
  passwordHash        String?
  role                UserRole             @default(player)
  status              AccountStatus        @default(active)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  externalIdentities  ExternalIdentity[]
  subscription        UserSubscription?
  accessGrants        AccessGrant[]        @relation("GrantRecipient")
  grantsCreated       AccessGrant[]        @relation("GrantCreator")
  grantsRevoked       AccessGrant[]        @relation("GrantRevoker")
  auditEventsAsActor  PrivilegedAuditLog[] @relation("AuditActor")
  auditEventsAsTarget PrivilegedAuditLog[] @relation("AuditTarget")

  @@index([status])
}

model ExternalIdentity {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  provider        IdentityProvider
  providerSubject String
  email           String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([email])
}

model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique
  familyId      String    @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model UserSubscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @unique @db.Uuid
  planCode               PlanCode
  status                 SubscriptionStatus @default(active)
  startsAt               DateTime           @default(now())
  currentPeriodEnd       DateTime?
  canceledAt             DateTime?
  provider               String?
  providerSubscriptionId String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan   @relation(fields: [planCode], references: [code], onDelete: Restrict)

  @@index([status, currentPeriodEnd])
  @@index([planCode])
}

model AccessGrant {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  type            AccessGrantType
  startsAt        DateTime        @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  reason          String
  grantedByUserId String          @db.Uuid
  revokedByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation("GrantRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy       User            @relation("GrantCreator", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedBy       User?           @relation("GrantRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([userId, type, startsAt, expiresAt, revokedAt])
  @@index([grantedByUserId])
  @@index([revokedByUserId])
}

model PrivilegedAuditLog {
  id           String                @id @default(uuid()) @db.Uuid
  actorUserId  String                @db.Uuid
  targetUserId String?               @db.Uuid
  action       PrivilegedAuditAction
  resourceType String
  resourceId   String
  reason       String
  metadata     Json?
  createdAt    DateTime              @default(now())
  actor        User                  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target       User?                 @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([resourceType, resourceId])
}

model GameContent {
  id        String   @id @default(uuid()) @db.Uuid
  gameId    String   @unique @db.Uuid
  version   Int      @default(1)
  payload   Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
