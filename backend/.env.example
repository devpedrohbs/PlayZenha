NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://playzenha:playzenha@localhost:5433/playzenha

# Use somente quando DATABASE_URL utilizar um pooler ou o provedor exigir uma conexao direta para migrations.
DIRECT_URL=postgresql://playzenha:playzenha@localhost:5433/playzenha

CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
LOG_LEVEL=debug

# Troque em producao. Precisa ter pelo menos 32 caracteres.
AUTH_JWT_SECRET=development-only-playzenha-auth-secret-change-me
AUTH_JWT_ISSUER=playzenha-api
AUTH_JWT_AUDIENCE=playzenha-web
AUTH_REFRESH_COOKIE_NAME=playzenha.refresh
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_PASSWORD_RESET_TTL_SECONDS=3600

# Mesmo OAuth 2.0 Client ID do tipo Web configurado no frontend.
AUTH_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
